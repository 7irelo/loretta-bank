# Copy to .env (git-ignored) and run `sh scripts/dev-secrets.sh` to generate the secrets below.
# Never commit real values.

# --- Generated by scripts/dev-secrets.sh -------------------------------------
POSTGRES_PASSWORD=
REDIS_PASSWORD=
# Signs user access/refresh tokens (auth-service, api-gateway)
JWT_SECRET=
# Signs short-lived service-to-service identity tokens (every service)
INTERNAL_JWT_SECRET=
# Password for the bootstrap admin created on first boot (admin@lorettabank.co.za)
ADMIN_PASSWORD=
# Signs the web client's step-up (re-authentication) cookies
SESSION_SECRET=

# --- AI providers (optional; AI features are disabled when unset) ------------
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPGRAM_API_KEY=

